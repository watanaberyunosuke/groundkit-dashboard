{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "yarn --cwd web install --frozen-lockfile",
  "buildCommand": "yarn --cwd web build",
  "outputDirectory": "web/dist",
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index" }],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{.env,.env.*,{.cursor,.github,.pytest_cache,build,config,data,dbt,dives,flights,scripts,src,tests,web}/**}"
    }
  },
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
